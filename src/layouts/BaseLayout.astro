---
/**
 * Base layout: document head, sidebar and main content area.
 */

import Sidebar from '../components/Sidebar.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;

const pageTitle = title ? `${title} - ${site.title}` : site.indexTitle;
const noIndex = site.noIndexPaths.includes(Astro.url.pathname);
const iconSizes = [48, 72, 96, 144, 192, 256, 384, 512];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <title>{pageTitle}</title>
    <meta name="og:title" content={pageTitle} />
    <meta name="og:description" content={site.description} />
    <meta name="og:type" content="website" />
    <meta
      name="google-site-verification"
      content="-afp9E5QbuMeEQi8FhPg-0g_sfaI-ZtjDht6epwGxEI"
    />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {iconSizes.map((size) => (
      <link
        rel="apple-touch-icon"
        sizes={`${size}x${size}`}
        href={`/icons/icon-${size}x${size}.png`}
      />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body>
    <div class="font-body">
      <Sidebar />

      <div class="max-w-6xl px-12 md:ml-92 md:px-24 py-10">
        <slot />
      </div>
    </div>
  </body>
</html>
